# CalCount backend — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env (die is gitignored) en vul in. Zet NOOIT een echte sleutel in de repo.

# Postgres (Neon). DATABASE_URL = pooled verbinding (hostnaam bevat "-pooler",
# gebruikt door de app/functie zelf); DIRECT_URL = directe verbinding (zonder
# "-pooler"), alleen gebruikt door `prisma migrate`. Beide staan in het
# Neon-dashboard onder Connection Details.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# Vereist voor AI-tekstschatting (Epic 2) en later AI-fotoherkenning (Epic 3).
# Zonder deze sleutel degradeert de app netjes: de AI-tab toont uitleg en verwijst
# naar Zoeken/Handmatig. Alle andere functies werken zonder sleutel.
ANTHROPIC_API_KEY=

# Optioneel: AI-model. Default is claude-opus-4-8.
# Zet op claude-haiku-4-5 voor lagere kosten (nauwkeurigheid valideren).
CALCOUNT_AI_MODEL=

# Optioneel: poort van de backend (default 3001).
PORT=
