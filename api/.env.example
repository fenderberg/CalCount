# CalCount backend — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env (die is gitignored) en vul in. Zet NOOIT een echte sleutel in de repo.

# Postgres (Neon). DATABASE_URL = pooled verbinding (hostnaam bevat "-pooler",
# gebruikt door de app/functie zelf); DIRECT_URL = directe verbinding (zonder
# "-pooler"), alleen gebruikt door `prisma migrate`. Beide staan in het
# Neon-dashboard onder Connection Details.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# Vereist voor AI-tekstschatting, wekelijkse inzichten, coach en AI-fotoherkenning.
# Zonder deze sleutel degradeert de app netjes: de AI-tab toont uitleg en verwijst
# naar Zoeken/Handmatig. Alle andere functies werken zonder sleutel.
ANTHROPIC_API_KEY=

# Optioneel: AI-model voor alle AI-functies (tekst, foto, inzichten en coach).
# Default is claude-haiku-4-5 (PRD v1.1 §9 beslissing 13).
CALCOUNT_AI_MODEL=

# Optioneel: los model specifiek voor AI-fotoherkenning (Epic 3). Valt terug op
# CALCOUNT_AI_MODEL als niet gezet. Noodgreep naar bv. claude-sonnet-5 als de
# nauwkeurigheid van het default-model op foto's tegenvalt (Story 3.1 Task 1).
CALCOUNT_AI_PHOTO_MODEL=

# Simpele single-user login (geen users-tabel — vaste gebruikersnaam/wachtwoord
# uit env, zie services/auth.ts). Verplicht: zonder deze drie is elke
# API-aanroep 401.
AUTH_USERNAME=
AUTH_PASSWORD=
# Willekeurige lange string — ondertekent de sessie-cookie (HMAC). Genereer
# bijv. met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Zet op 'true' in productie (Render, HTTPS) zodat de sessie-cookie
# SameSite=None; Secure krijgt (nodig omdat frontend/backend andere origins
# zijn). Lokaal blijft dit leeg/false: frontend en backend draaien dan via
# Vite's dev-proxy op hetzelfde origin (localhost:5173), dus SameSite=Lax
# zonder Secure volstaat en werkt ook zonder HTTPS.
COOKIE_SECURE=

# Optioneel: poort van de backend (default 3001).
PORT=
