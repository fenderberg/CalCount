// CalCount datamodel (single-user v1). Postgres (Neon) in productie.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Single-user: er is precies één profiel (id = 1).
model Profile {
  id                Int      @id @default(1)
  heightCm          Float
  weightKg          Float
  birthDate         String // ISO-datum YYYY-MM-DD
  sex               String // 'male' | 'female'
  activityLevel     String // sedentary | light | moderate | active | very_active
  goalRateKgPerWeek Float
  targetWeightKg    Float?
  timeZone           String?
  theme              String   @default("light")
  updatedAt         DateTime @updatedAt
}

// Eetlog (Epic 2).
model FoodEntry {
  id         String   @id @default(cuid())
  loggedAt   DateTime
  name       String
  source     String // 'search' | 'manual' | 'ai' | 'recent' | 'photo'
  grams      Float?
  calories   Float
  protein    Float?
  carbs      Float?
  fat        Float?
  isEstimate Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([loggedAt])
}

// Referentie-cache: producten met kcal/100g (uit Open Food Facts, handmatig of AI).
// Voedt de zoek-/recent-lijst en maakt her-loggen snel en offline mogelijk.
model FoodReference {
  id              String   @id @default(cuid())
  name            String
  caloriesPer100g Float
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  source          String // 'off' | 'manual' | 'ai'
  externalId      String?  @unique
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
}

model WeightEntry {
  id         String   @id @default(cuid())
  measuredAt DateTime
  weightKg   Float

  @@index([measuredAt])
}

// Permanent toegekende prestaties (Story 5.2). Awards worden nooit verwijderd.
model BadgeAward {
  key      String   @id
  earnedAt DateTime @default(now())
}

// Onveranderlijke wekelijkse AI-inzichten (Story 6.1).
model AiInsight {
  id          String   @id @default(cuid())
  windowStart String
  windowEnd   String
  content     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Alleen de teller wordt bewaard; coachberichten blijven in de browsersessie.
model AiCoachUsage {
  day   String @id
  count Int    @default(0)
}
