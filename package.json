{
  "name": "calcount",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "test": "npm run test -w @calcount/core",
    "dev:api": "npm run dev -w api",
